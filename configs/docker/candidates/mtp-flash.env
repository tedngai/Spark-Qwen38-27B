# profile: mtp-flash — DFLASH speculative decoding (draft model
# incoai/Qwen3.8-27B-DFlash2, 4 draft tokens) on the old MTP-era settings.
# Replaces mtp-eagle (2026-10-16, user request): flash draft model instead of
# the in-checkpoint EAGLE MTP head. DFLASH borrowed from the RTX PRO 6000
# node's validated profile.
MEM_FRACTION=0.92
MAX_RUNNING_REQUESTS=12
CHUNKED_PREFILL=8192
DISABLE_PREFILL_CUDA_GRAPH=1
MAMBA_SSM_DTYPE=bfloat16
MAMBA_FULL_MEMORY_RATIO=4.21
MAX_MAMBA_CACHE_SIZE=96
# DFLASH rejects extra_buffer_lazy; extra_buffer is required.
MAMBA_RADIX_CACHE_STRATEGY=extra_buffer
SPEC_ALGORITHM=DFLASH
SPEC_DRAFT_MODEL=incoai/Qwen3.8-27B-DFlash2
# empty = engine default draft attention backend (as on the RTX node)
SPEC_DRAFT_ATTENTION_BACKEND=
SPEC_NUM_DRAFT_TOKENS=4
