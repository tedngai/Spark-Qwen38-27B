# profile: 512k-yarn — 524288-token context (YaRN factor 2), the historic
# configuration that OOM'd the 128 GB unified memory: NVRM NV_ERR_NO_MEMORY
# with heavy swap at 12 concurrent + mem fraction 0.95.
# WARNING: reproduction/history only. Expect instability; only run when you
# want to re-test the 2026-10-13 failure mode or explore a safer variant
# (e.g. lower mem fraction / fewer concurrent users first).
CONTEXT_LENGTH=524288
YARN=1
MEM_FRACTION=0.95
MAX_RUNNING_REQUESTS=12
CHUNKED_PREFILL=8192
DISABLE_PREFILL_CUDA_GRAPH=1
MAMBA_SSM_DTYPE=bfloat16
MAMBA_FULL_MEMORY_RATIO=4.21
MAX_MAMBA_CACHE_SIZE=96
SPEC_ALGORITHM=EAGLE
SPEC_NUM_STEPS=3
SPEC_EAGLE_TOPK=1
SPEC_NUM_DRAFT_TOKENS=4
