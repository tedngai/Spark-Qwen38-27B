# profile: combo-bf16-c12 — combine the two strongest findings of the first
# sweep pass: the bf16 GDN pool (mamba-bf16: small speed edge at c8/c16, +55%
# KV capacity) and the admission cap of 12 (maxreq-12: no queueing at c12+,
# best c12 aggregate). Everything else stays at the validated baseline
# (mem 0.85, chunked prefill 2048, DSPARK d8, flashinfer).
# Hypothesis: keep the bf16 pool's speed/capacity while serving 12 users
# without the queue cliff of the baseline cap of 8.
MAMBA_SSM_DTYPE=bfloat16
MAMBA_FULL_MEMORY_RATIO=4.21
MAX_MAMBA_CACHE_SIZE=96
MAX_RUNNING_REQUESTS=12
