# profile: mtp-eagle — the pre-DSPARK validated config: in-checkpoint EAGLE
# MTP (3 steps / topk 1 / 4 draft tokens), chunked prefill 8192, prefill
# CUDA graph disabled, bf16 mamba, mem fraction 0.92, 12 concurrent.
# Hypothesis: EAGLE vs DSPARK acceptance/speed on identical scenarios.
MEM_FRACTION=0.92
MAX_RUNNING_REQUESTS=12
CHUNKED_PREFILL=8192
DISABLE_PREFILL_CUDA_GRAPH=1
MAMBA_SSM_DTYPE=bfloat16
MAMBA_FULL_MEMORY_RATIO=4.21
MAX_MAMBA_CACHE_SIZE=96
SPEC_ALGORITHM=EAGLE
SPEC_NUM_STEPS=3
SPEC_EAGLE_TOPK=1
SPEC_NUM_DRAFT_TOKENS=4
