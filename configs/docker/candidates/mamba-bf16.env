# profile: mamba-bf16 — bfloat16 GDN state pool with the smaller full-memory
# ratio (the pre-DSPARK tuning). Hypothesis: saves ~20 GB of unified memory
# versus the float32/11.01 pool -> more KV slots; watch decode speed.
MAMBA_SSM_DTYPE=bfloat16
MAMBA_FULL_MEMORY_RATIO=4.21
MAX_MAMBA_CACHE_SIZE=64
