# profile: dflash-d8 — DFLASH with 8 draft tokens; identical surroundings to
# mtp-flash (d4) so the pair isolates the draft-token/block-size effect.
# (Replaced the invalid dspark-d4 attempt — DSPARK pins draft tokens to 8 —
# see evidence/dspark-d4-invalid-20261016.md.)
# Hypothesis (the RTX PRO 6000 node chose DFLASH d4 over d8): do longer
# DFLASH windows raise acceptance enough to pay for the extra verify work on GB10?
MEM_FRACTION=0.92
MAX_RUNNING_REQUESTS=12
CHUNKED_PREFILL=8192
DISABLE_PREFILL_CUDA_GRAPH=1
MAMBA_SSM_DTYPE=bfloat16
MAMBA_FULL_MEMORY_RATIO=4.21
MAX_MAMBA_CACHE_SIZE=96
# DFLASH rejects extra_buffer_lazy; extra_buffer is required.
MAMBA_RADIX_CACHE_STRATEGY=extra_buffer
SPEC_ALGORITHM=DFLASH
SPEC_DRAFT_MODEL=incoai/Qwen3.8-27B-DFlash2
SPEC_DRAFT_ATTENTION_BACKEND=
SPEC_NUM_DRAFT_TOKENS=8
