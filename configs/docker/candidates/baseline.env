# profile: baseline — the currently validated configuration (packaged 2026-10-16).
#
# This file records the deployed baseline exactly as it was running. The
# launcher defaults already equal these values; drift between this file and
# the defaults is a bug. First benchmark in any sweep for a like-for-like
# reference point.
MEM_FRACTION=0.85
MAX_RUNNING_REQUESTS=8
KV_CACHE_DTYPE=fp8_e4m3
ATTENTION_BACKEND=flashinfer
CHUNKED_PREFILL=2048
MAMBA_SSM_DTYPE=float32
MAMBA_FULL_MEMORY_RATIO=11.01
MAMBA_RADIX_CACHE_STRATEGY=extra_buffer_lazy
DISABLE_PREFILL_CUDA_GRAPH=0
SPEC_ALGORITHM=DSPARK
SPEC_DRAFT_MODEL=RadixArk/Qwen3.8-27B-DSpark
SPEC_DRAFT_ATTENTION_BACKEND=flashinfer
CONTEXT_LENGTH=262144
YARN=0
