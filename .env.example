# Copy to .env and fill in. The launcher scripts source this file.
HF_TOKEN=hf_xxx

# Optional: publishing token for the Pratt Gitea remote (see AGENTS.md).
# GITEA_TOKEN=xxxx

# Global default context. 262144 (native, no override) .. 1000000.
# >262144 needs YARN=1 (or exactly 1000000, auto-enables YaRN).
# Keep 262144 + YARN=0 unless you know the memory budget.
# Profiles in configs/docker/candidates/ may override these.
CONTEXT_LENGTH=262144
YARN=0
